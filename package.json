{
  "name": "dsh-tps-ttft",
  "version": "1.0.0",
  "description": "Per-turn TPS and TTFT statistics for DeepSeek Harness: model time, tool time, time-to-first-token, and output speed per turn, shown as a timing pill in the turn tail.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oldzhang82/dsh-tps-ttft.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "tps",
    "ttft",
    "per-turn-stats",
    "projection",
    "model-time",
    "output-speed"
  ],
  "license": "MIT"
}