{
  "name": "dsh-tps-ttft",
  "version": "1.0.0",
  "description": "Per-turn TPS and TTFT statistics for DeepSeek Harness: model time, tool time, time-to-first-token, and output speed per turn, shown in the Turn Usage panel.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "tps",
    "ttft",
    "per-turn-stats",
    "projection",
    "model-time",
    "output-speed"
  ],
  "license": "MIT"
}
